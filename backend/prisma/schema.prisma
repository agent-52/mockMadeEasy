// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===================
// ENUMS
// ===================

enum InterviewPhase{
  base
  followup
  completed
}
enum Status{
  active
  completed
  cancelled
}
enum InterviewRole{
  frontend
  backend
  fullstack
  dsa
}
enum SubjectCategory{
  frontend
  backend
  database
  dsa
  system_design
}
enum Mode{
  theory
  coding
  mixed
}
enum Role {
  admin
  user
}
enum Language{
  node 
  cpp
  python
}
enum Difficulty {
  easy
  medium
  hard
}
enum QuestionType{
  theory
  coding
}

enum SubjectType {
  react
  node
  dsa
  database
  system_design
}

// ===================
// MODELS
// ===================

model User {
  id          Int          @id @default(autoincrement())
  name        String
  email       String       @unique
  password    String
  role        Role         @default(user)
  createdAt   DateTime     @default(now())

  interviews  Interview[]
  statsCards  StatsCard[]
  refreshTokens RefreshTokens[]
}

// -------------------
// Questions
// -------------------
model Question {
  id          Int                 @id @default(autoincrement())
  title       String
  slug        String              @unique
  description String?
  difficulty  Difficulty
  followUpToQuesitonId  Int?
  type        QuestionType?
  constraints String?
  inputFormat String?
  outputFormat String?
  starterCode String?
  averageTime Int @default(7)
  createdAt   DateTime             @default(now())

  // Relations
  topics      QuestionTopic[]
  testCases  TestCase[]
  companies   QuestionCompany[]
  interviewQs InterviewQuestion[]
  statsCardDetails StatsCardDetail[]  
}

// Mapping: Question ↔ Company
model Company {
  id         Int                @id @default(autoincrement())
  name       String  @unique
  questions  QuestionCompany[]
}

model QuestionCompany {
  id         Int      @id @default(autoincrement())
  questionId Int
  companyId  Int

  question   Question @relation(fields: [questionId], references: [id])
  company    Company  @relation(fields: [companyId], references: [id])

  @@unique([questionId, companyId])
}

// Mapping: Question ↔ Topic
model Topic {
  id         Int             @id @default(autoincrement())
  name       String          
  subjectId  Int

  subject    Subject         @relation(fields: [subjectId], references: [id])
  questions  QuestionTopic[]

   @@unique([name, subjectId])
}

model Subject {
  id       Int       @id @default(autoincrement())
  title    SubjectType  @unique
  categoty SubjectCategory
  topics   Topic[]
}

model QuestionTopic {
  id         Int      @id @default(autoincrement())
  questionId Int
  topicId    Int

  question   Question @relation(fields: [questionId], references: [id])
  topic      Topic    @relation(fields: [topicId], references: [id])

  @@unique([questionId, topicId])
}

// -------------------
// Interviews
// -------------------
model Interview {
  id          Int                 @id @default(autoincrement())
  userId      Int

  startedAt   DateTime            @default(now())
  endedAt     DateTime?

  title       String?
  roleType    InterviewRole
  difficulty   Difficulty
  subjects      SubjectType[]
  estimatedDuration   DateTime?
  status     Status
  includeIntro  Boolean @default(false)
  phase InterviewPhase @default(base)
  lastEvaluatedPhase InterviewPhase?

  communicationClarity String?
  conceptDepth String?
  logicalThinking String?
  confidenceLevel String?
  codeStructure String?
  strengths String[] 
  areasToImprove String[]
  recommendedFocus String[]
  aiSummaryGenerated Boolean @default(false)

  user        User                @relation(fields: [userId], references: [id])
  statsCards  StatsCard?
  questions   InterviewQuestion[]

  @@index([userId, startedAt])
}

// Mapping: Interview ↔ Question
model InterviewQuestion {
  id          Int       @id @default(autoincrement())
  interviewId Int
  questionId  Int
  isCorrect   Boolean?
  order       Int?
  timeTaken   Int @default(0)      // in seconds

  skipped Boolean @default(false)

  clarityScore Int?
  conceptDepthScore Int?
  logicalThinkingScore Int?
  confidenceScore Int?
  overallScore Int?
  idealAnswer String?
  gapAnalysis String?
  aiFeedback String?
  strengths  String[]
  areasToImprove String[]
  timeInsight Json ?

  //for coding quesiton ai evaluation
  correctnessScore Int?
  codeQualityScore Int?
  problemSolvingScore Int?

  
  interview   Interview @relation(fields: [interviewId], references: [id])
  question    Question  @relation(fields: [questionId], references: [id])
  response UserResponse?
  @@unique([interviewId, questionId])
}

// -------------------
// Responses
// -------------------
model UserResponse {
  id          Int       @id @default(autoincrement())
  interviewQuestionId  Int
  response    String
  attemptedAt DateTime  @default(now())
  language Language?
  interviewQuestion  InterviewQuestion @relation(fields: [interviewQuestionId], references:[id])

  @@unique([interviewQuestionId])
  
}

// -------------------
// Stats
// -------------------
model StatsCard {
  id             Int              @id @default(autoincrement())
  userId         Int
  interviewId    Int              @unique
  totalAttempted Int              @default(0)
  totalCorrect   Int              @default(0)
  accuracy       Float            @default(0)
  lastUpdated    DateTime         @default(now())

  user           User             @relation(fields: [userId], references: [id])
  interview      Interview        @relation(fields: [interviewId], references: [id])
  details        StatsCardDetail[]
}

model StatsCardDetail {
  id          Int       @id @default(autoincrement())
  statsCardId Int
  questionId  Int
  isCorrect   Boolean?

  statsCard   StatsCard @relation(fields: [statsCardId], references: [id])
  question    Question  @relation(fields: [questionId], references: [id])
  codeExecutionResult CodeExecutionResult?
  @@unique([statsCardId, questionId])
}

model RefreshTokens{
  id Int @id @default(autoincrement())
  userId Int 
  tokenHash String
  expiresAt DateTime 
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])

}

model TestCase{
  id Int @id @default(autoincrement())
  questionId Int
  input String
  expectedOutput String
  isPublic Boolean @default(false)

  question Question @relation(fields: [questionId], references: [id])

  @@index([questionId])
}

model CodeExecutionResult {
  id           Int      @id @default(autoincrement())
  statsCardDetailId Int  @unique
  passedCount   Int
  failedCount   Int
  totalCount    Int
  passed        Boolean
  error        String?
  runtimeMs    Int?
  createdAt    DateTime @default(now())

  statsCardDetail StatsCardDetail @relation(fields: [statsCardDetailId], references: [id])

  
}

model TtsCache{
  id  Int @id@default(autoincrement())
  textHash String @unique 
  text String
  audioUrl String
  createdAt DateTime @default(now())
}

